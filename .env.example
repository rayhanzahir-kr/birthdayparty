# =============================================================================
# BIRTHDAY://PROTOCOL — example environment
#
# Copy this to .env.local and fill in your own values.
# Do NOT commit .env.local (already ignored by .gitignore).
# This file contains no real credentials.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# From Supabase Dashboard -> Project Settings -> API Keys
#
# Note: no variable here uses the NEXT_PUBLIC_ prefix, because the browser never
# talks to Supabase directly (admin sign-in goes through a server route). These
# values are read on the server only and never reach the client bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Supabase: SERVER ONLY ---------------------------------------------------
# This key bypasses RLS. Never give it a NEXT_PUBLIC prefix, never send it to the
# browser, and never commit it. On Vercel, store it without exposing it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Site URL ----------------------------------------------------------------
# Used to build the invitation links you share with guests.
# Also acts as a fallback origin allowlist for older browsers; modern browsers
# are already covered by the Sec-Fetch-Site header, so a wrong value here will
# not break the app — it only makes generated links point at the wrong domain.
# Local: http://localhost:3000 — Production: https://your-project.vercel.app
SITE_URL=http://localhost:3000

# --- "Key to join" (SERVER ONLY) ---------------------------------------------
# SHA-256 hex of the host's birthday in canonical YYYY-MM-DD form.
# Generate it with:  npm run hash-password
# The password itself must never be written in this file or in any NEXT_PUBLIC
# variable.
INVITE_PASSWORD_HASH=

# --- Optional ----------------------------------------------------------------
# Extra origins allowed to send mutations, comma separated.
# ADDITIONAL_ALLOWED_ORIGINS=https://preview-branch.vercel.app

# Trusted IP header when hosting behind a proxy other than Vercel.
# Leave empty on Vercel — the platform already sets x-forwarded-for.
# TRUSTED_IP_HEADER=
