# =============================================================================
# BIRTHDAY://PROTOCOL — contoh environment
#
# Salin menjadi .env.local lalu isi dengan nilai proyekmu.
# JANGAN commit .env.local (sudah diabaikan .gitignore).
# Tidak ada kredensial asli di file ini.
# =============================================================================

# --- Supabase: aman untuk browser -------------------------------------------
# Dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Supabase: SERVER SAJA ---------------------------------------------------
# Kunci ini melewati RLS. Jangan beri prefix NEXT_PUBLIC, jangan kirim ke
# browser, dan jangan commit. Di Vercel, simpan tanpa centang "expose".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- URL situs ---------------------------------------------------------------
# Dipakai untuk membangun link undangan dan sebagai allowlist origin (CSRF).
# Lokal: http://localhost:3000 — Produksi: https://nama-proyek.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Kunci "ikut acara" (SERVER SAJA) ---------------------------------------
# SHA-256 hex dari tanggal lahir penyelenggara dalam bentuk kanonis YYYY-MM-DD.
# Buat dengan:  npm run hash-password
# Password aslinya TIDAK boleh ditulis di file ini atau di env NEXT_PUBLIC apa pun.
INVITE_PASSWORD_HASH=

# --- Opsional ----------------------------------------------------------------
# Origin tambahan yang diizinkan melakukan mutasi, dipisah koma.
# ADDITIONAL_ALLOWED_ORIGINS=https://preview-branch.vercel.app

# Header IP tepercaya bila di-host di belakang proxy selain Vercel.
# Biarkan kosong di Vercel — platform sudah menyetel x-forwarded-for.
# TRUSTED_IP_HEADER=
