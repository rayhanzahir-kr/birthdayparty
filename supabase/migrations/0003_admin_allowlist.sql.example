-- =============================================================================
-- EXAMPLE: add an admin to the allowlist.
--
-- Run this MANUALLY in the Supabase SQL Editor after creating the account under
-- Authentication -> Users -> Add user. There is no public sign-up and no path
-- from the browser to add yourself to this table.
--
-- Replace the email address below, then run it.
-- =============================================================================
insert into public.admin_users (user_id, note)
select id, 'primary host'
from auth.users
where email = 'replace-with-admin-email@example.com'
on conflict (user_id) do nothing;

